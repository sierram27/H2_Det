          elements="O H N He Ar",
          species="""AR    HE    N2    H2    H     O     O2    OH    H2O
                     HO2   H2O2  O3""",
          reactions='all',
          transport='Mix',
          initial_state=state(temperature=300.0, pressure=OneAtm))

